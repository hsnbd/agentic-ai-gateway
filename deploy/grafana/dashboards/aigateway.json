{
  "title": "AI Gateway Overview", "uid": "aigateway", "schemaVersion": 39, "version": 1,
  "refresh": "15s", "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"id":1,"type":"timeseries","title":"Request rate","gridPos":{"x":0,"y":0,"w":12,"h":8},"targets":[{"expr":"sum(rate(aigw_requests_total[5m]))","legendFormat":"requests/s"}]},
    {"id":2,"type":"timeseries","title":"Error rate","gridPos":{"x":12,"y":0,"w":12,"h":8},"targets":[{"expr":"sum(rate(aigw_errors_total[5m]))","legendFormat":"errors/s"}]},
    {"id":3,"type":"timeseries","title":"Latency p50 / p95 / p99","gridPos":{"x":0,"y":8,"w":12,"h":8},"targets":[{"expr":"histogram_quantile(0.50, sum(rate(aigw_request_duration_seconds_bucket[5m])) by (le))","legendFormat":"p50"},{"expr":"histogram_quantile(0.95, sum(rate(aigw_request_duration_seconds_bucket[5m])) by (le))","legendFormat":"p95"},{"expr":"histogram_quantile(0.99, sum(rate(aigw_request_duration_seconds_bucket[5m])) by (le))","legendFormat":"p99"}]},
    {"id":4,"type":"timeseries","title":"Time to first token","gridPos":{"x":12,"y":8,"w":12,"h":8},"targets":[{"expr":"histogram_quantile(0.95, sum(rate(aigw_time_to_first_token_seconds_bucket[5m])) by (le))","legendFormat":"p95"}]},
    {"id":5,"type":"timeseries","title":"Cache hit ratio","gridPos":{"x":0,"y":16,"w":8,"h":8},"targets":[{"expr":"aigw_cache_hit_ratio","legendFormat":"hit ratio"}]},
    {"id":6,"type":"timeseries","title":"Fallbacks and retries","gridPos":{"x":8,"y":16,"w":8,"h":8},"targets":[{"expr":"sum(rate(aigw_fallbacks_total[5m]))","legendFormat":"fallbacks/s"},{"expr":"sum(rate(aigw_retries_total[5m]))","legendFormat":"retries/s"}]},
    {"id":7,"type":"timeseries","title":"Tokens","gridPos":{"x":16,"y":16,"w":8,"h":8},"targets":[{"expr":"sum by (kind) (rate(aigw_tokens_total[5m]))","legendFormat":"{{kind}}"}]},
    {"id":8,"type":"timeseries","title":"Estimated cost","gridPos":{"x":0,"y":24,"w":12,"h":8},"targets":[{"expr":"sum(rate(aigw_cost_usd_total[5m]))","legendFormat":"USD/s"}]},
    {"id":9,"type":"state-timeline","title":"Provider health","gridPos":{"x":12,"y":24,"w":12,"h":8},"targets":[{"expr":"aigw_provider_healthy","legendFormat":"{{provider}} / {{deployment}}"}]}
  ]
}
